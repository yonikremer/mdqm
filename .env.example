# Throwaway development credentials for the docker-compose stack (task D01).
#
# Copy to `.env` before the first `python scripts/dev.py up` (`python scripts/dev.py env` does it):
#
#     python scripts/dev.py env
#
# `.env` is git-ignored. Everything here is a local-only dev password for a service bound to
# 127.0.0.1 — no value is or may become a real credential. Oracle and SQL Server reject a password
# that does not meet their own policy, so do not "simplify" these.

# PostgreSQL: superuser password (owner of the crm/billing/erp databases) and the password of the
# shared read-only account `mdqm_ro` that every adapter's read-only login uses.
MDQM_PG_PASSWORD=MqmDevPg2026
MDQM_RO_PASSWORD=MqmDevReadOnly2026

# Oracle Free: the password of the SYS/system account. 12+ characters, letters and digits only.
MDQM_ORACLE_PASSWORD=MqmDevOracle2026

# SQL Server: the `sa` password. Needs 8+ characters from 3 of 4 classes (upper, lower, digit, symbol).
MDQM_MSSQL_PASSWORD=MqmDevSql2026!

# The mock internal API (D04) answers nothing without this key: it is an `apiKey` header.
MDQM_MOCK_API_KEY=MqmDevApiKey2026

# Host ports, all bound to 127.0.0.1 only. Non-default on purpose, so a locally installed engine
# is never shadowed. Change one here and the compose file follows.
MDQM_PG_PORT=55440
MDQM_ORACLE_PORT=51521
MDQM_MSSQL_PORT=51433
MDQM_ES_PORT=59200
MDQM_API_PORT=58000

# The open-source-only stack (`oss` profile: Postgres + MariaDB + OpenSearch + the mock API).
# MariaDB has its own root password; its read-only account reuses MDQM_RO_PASSWORD above, the same
# variable the PostgreSQL and Oracle services use. Throwaway values, like everything else here.
MDQM_MARIADB_ROOT_PASSWORD=MqmDevMaria2026
MDQM_MARIADB_PORT=53306
MDQM_OPENSEARCH_PORT=59201
