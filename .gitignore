__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.env
/data/
*.duckdb
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Staged wheels are deployment artefacts, never repository files. The directory itself is kept
# (with a placeholder) because the Dockerfile COPYs it: an absent directory fails the build even
# in mirror mode, which never reads its contents.
wheelhouse/*
!wheelhouse/.gitkeep
.worktrees/
docker/server/*
!docker/server/tokens.example.json
/bench/
